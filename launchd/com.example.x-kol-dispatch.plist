<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.x-kol-dispatch</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/ABSOLUTE/PATH/TO/x-kol-monitor/scripts/run_x_kol_dispatch_launchd.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>10</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/ABSOLUTE/PATH/TO/x-kol-monitor</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>X_KOL_WORKSPACE</key>
		<string>/ABSOLUTE/PATH/TO/x-kol-monitor</string>
		<key>X_KOL_PYTHON</key>
		<string>/usr/bin/python3</string>
		<key>X_KOL_FEISHU_PROFILE</key>
		<string>your-lark-cli-profile</string>
		<key>X_KOL_FEISHU_CHAT_ID</key>
		<string>oc_your_chat_id</string>
		<key>X_KOL_PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/ABSOLUTE/PATH/TO/x-kol-monitor/logs/dispatch.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/ABSOLUTE/PATH/TO/x-kol-monitor/logs/dispatch.stderr.log</string>
</dict>
</plist>
