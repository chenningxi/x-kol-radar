<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.x-kol-pipeline</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/x-kol-monitor/scripts/run_x_kol_pipeline_launchd.sh</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>
    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/x-kol-monitor</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>X_KOL_WORKSPACE</key>
        <string>/ABSOLUTE/PATH/TO/x-kol-monitor</string>
        <key>X_KOL_PYTHON</key>
        <string>/ABSOLUTE/PATH/TO/x-kol-monitor/.venv/bin/python</string>
        <key>X_KOL_PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/x-kol-monitor/logs/pipeline.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/x-kol-monitor/logs/pipeline.stderr.log</string>
</dict>
</plist>
