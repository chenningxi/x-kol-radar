# Required for Feishu dispatch mode
X_KOL_FEISHU_PROFILE=your-lark-cli-profile
X_KOL_FEISHU_CHAT_ID=oc_your_chat_id

# Optional runtime overrides
X_KOL_WORKSPACE=/absolute/path/to/your/workspace
X_KOL_PYTHON=python3
X_KOL_OPENCLI=opencli

# For macOS launchd, use an absolute PATH containing opencli and lark-cli.
X_KOL_PATH=/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin
