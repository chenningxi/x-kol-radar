# Required for Feishu dispatch mode
X_KOL_FEISHU_PROFILE=your-lark-cli-profile
X_KOL_FEISHU_CHAT_ID=oc_your_chat_id

# Optional isolated quote-display test target; never falls back to the main group.
# Configure exactly one target and explicitly use --send after approving the test.
# X_KOL_FEISHU_TEST_CHAT_ID=oc_test_chat_id
# X_KOL_FEISHU_TEST_USER_ID=ou_test_user_id

# Optional runtime overrides
X_KOL_WORKSPACE=/absolute/path/to/your/workspace
X_KOL_PYTHON=/absolute/path/to/x-kol-radar/.venv/bin/python
X_KOL_OPENCLI=opencli
# X reads explicitly use --window background; no OPENCLI_WINDOW override needed.
# Optional image directory; defaults to data/media/ under the workspace.
# X_KOL_MEDIA_DIR=/absolute/path/to/private/x-kol-media
# Image-work budgets in seconds (1-600 each); timeline fetching is not charged.
X_KOL_MEDIA_DOWNLOAD_BUDGET_SECONDS=300
X_KOL_MEDIA_RETRY_BUDGET_SECONDS=180
# Independent budget for monitored, outer-post and quoted authors' avatars.
X_KOL_AVATAR_BUDGET_SECONDS=180
# Independent profile verification read budget; missing snapshots retry each sync.
X_KOL_VERIFICATION_BUDGET_SECONDS=180

# For macOS launchd, use an absolute PATH containing opencli and lark-cli.
X_KOL_PATH=/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin

# MySQL is the runtime source of truth; Redis provides the workflow lock.
# query_x_kol_profiles.py and query_x_kol_tweets.py only need these MySQL settings.
X_KOL_MYSQL_HOST=127.0.0.1
X_KOL_MYSQL_PORT=3306
X_KOL_MYSQL_DATABASE=your_database
X_KOL_MYSQL_USER=your_user
X_KOL_MYSQL_PASSWORD=
X_KOL_REDIS_HOST=127.0.0.1
X_KOL_REDIS_PORT=6379
X_KOL_REDIS_DB=0
X_KOL_REDIS_PASSWORD=
X_KOL_REDIS_PREFIX=xkol:radar

# Direct DeepSeek API; the 15-minute pipeline runs sync -> review -> dispatch.
# Keep the key in your private .env only. No OpenAI service is called.
DEEPSEEK_API_KEY=
X_KOL_DEEPSEEK_MODEL=deepseek-flash
